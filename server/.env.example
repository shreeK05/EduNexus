# --- DATABASE ---
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/edunexus

# --- AUTH ---
JWT_SECRET=your_super_secret_key_123

# --- CLOUDINARY (For File Uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- EMAIL SERVICE (SMTP) ---
# For Brevo:
# EMAIL_SERVICE=brevo
# EMAIL_USER=your-brevo-login (e.g. a9c806001@smtp-brevo.com)
# EMAIL_PASS=your-brevo-smtp-key
# EMAIL_FROM=your-verified-sender-email@gmail.com

# For Gmail: 
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-gmail@gmail.com
# EMAIL_PASS=your-16-char-app-password
# EMAIL_FROM=your-gmail@gmail.com

EMAIL_SERVICE=brevo
EMAIL_USER=your_login_here
EMAIL_PASS=your_smtp_key_here
EMAIL_FROM=your_verified_sender_email_here

# --- APP INFO ---
PORT=10000
NODE_ENV=production
